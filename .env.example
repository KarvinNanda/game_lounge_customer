# Salin ke .env.local untuk development lokal (di-gitignore).
# Semua VITE_* di-bake ke bundle browser: jangan isi dengan secret.
VITE_API_URL=http://localhost:8080/api

# Host payment gateway yang boleh jadi tujuan redirect invoice (pisah koma).
# Kosong = default checkout.xendit.co,checkout-staging.xendit.co
VITE_PAYMENT_HOSTS=

# true = aktifkan halaman /payment/mock dan endpoint mock-confirm (dev/staging saja).
# Production: biarkan kosong — endpoint mock-confirm tidak ada di backend production.
VITE_ENABLE_MOCK_PAYMENT=
